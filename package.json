{
  "name": "@npvd/npvd-pnpm-v6",
  "version": "0.1.1",
  "description": "Legacy pnpm lockfile v6 support for npvd",
  "type": "module",
  "scripts": {
    "build": "tsdown && publint"
  },
  "engines": {
    "node": ">= 20"
  },
  "main": "./dist/index.cjs",
  "exports": {
    "require": "./dist/index.cjs",
    "import": "./dist/index.mjs"
  },
  "files": [
    "/dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdmower/npvd-pnpm-v6.git"
  },
  "author": "Matt Mower <mdmower@cmphys.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mdmower/npvd-pnpm-v6/issues"
  },
  "homepage": "https://github.com/mdmower/npvd-pnpm-v6#readme",
  "dependencies": {
    "@pnpm/lockfile-file": "^9.1.3",
    "@pnpm/lockfile-walker": "^9.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "publint": "^0.3.21",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
